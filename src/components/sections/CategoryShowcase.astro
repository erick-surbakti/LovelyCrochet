---
import Img from '@/components/ui/Img.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { path, type Locale } from '@/i18n/routes';
import { categoryUrl, getCategories } from '@/lib/content';

interface Props {
  locale: Locale;
  kicker: string;
  title: string;
  lede?: string;
}
const { locale, kicker, title, lede } = Astro.props;
const categories = await getCategories();
const tilts = [-2, 1.5, -1, 2, -1.5, 1, -2, 1.5];
const bgs = ['bg-blush', 'bg-oat', 'bg-[#dfe7dc]', 'bg-butter/60', 'bg-oat', 'bg-blush', 'bg-[#dfe7dc]'];
const custom = {
  id: { name: 'Pesanan Custom', short: 'Punya ide sendiri? Rancang warnanya, kami yang merajut.' },
  en: { name: 'Custom Orders', short: 'Have your own idea? You pick the colours, we crochet it.' },
}[locale];
---

<section class="container-lc py-16" aria-labelledby="collections-title">
  <SectionTitle id="collections-title" kicker={kicker} title={title} lede={lede} />
  <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-3">
    {categories.map((c, i) => (
      <li class="rise">
        <a href={categoryUrl(c, locale)} class="group block rounded-[1.6rem]">
          <div class:list={['polaroid !p-2 !pb-2', bgs[i]]} style={`--tilt:${tilts[i]}deg`}>
            <Img
              name={c.data.image}
              locale={locale}
              sizes="(min-width: 1200px) 370px, (min-width: 1024px) 30vw, 45vw"
              widths={[240, 360, 480, 640]}
              class="aspect-[4/5] w-full rounded-[1rem] object-cover"
            />
          </div>
          <h3 class="mt-4 text-step-1">
            <span class="link-draw">{c.data.name[locale]}</span>
          </h3>
          <p class="mt-1 text-step--1 text-cocoa-soft">{c.data.short[locale]}</p>
        </a>
      </li>
    ))}
    <li class="rise">
      <a href={path('custom', locale)} class="group block rounded-[1.6rem]">
        <div class="polaroid !p-2 !pb-2 bg-butter/60" style={`--tilt:${tilts[7]}deg`}>
          <div class="grid aspect-[4/5] w-full place-items-center rounded-[1rem] bg-cream">
            <svg viewBox="0 0 120 120" class="w-3/5" aria-hidden="true" focusable="false">
              <circle cx="60" cy="60" r="40" fill="var(--color-blush)"></circle>
              <g fill="none" stroke="var(--color-rose-ink)" stroke-width="3" stroke-linecap="round">
                <path d="M26 52c14 8 50 8 68-4"></path>
                <path d="M22 66c18 10 56 8 76-6"></path>
                <path d="M34 82c14 6 36 4 50-6"></path>
                <path d="M46 22c-10 18-10 52 4 76"></path>
              </g>
              <path
                class="yarn-path yarn-draw"
                pathLength="1"
                stroke="var(--color-rose-clay)"
                stroke-width="3"
                d="M96 84c10 8 14 18 6 26-8 8-20 0-14-8"></path>
              <path
                d="M84 18l4 10 10 4-10 4-4 10-4-10-10-4 10-4z"
                fill="var(--color-butter)"
                stroke="var(--color-cocoa)"
                stroke-width="1.5"></path>
            </svg>
          </div>
        </div>
        <h3 class="mt-4 text-step-1">
          <span class="link-draw">{custom.name}</span>
        </h3>
        <p class="mt-1 text-step--1 text-cocoa-soft">{custom.short}</p>
      </a>
    </li>
  </ul>
</section>
