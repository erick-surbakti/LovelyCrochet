---
import { Icon } from 'astro-icon/components';
import { path, type Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { generalMessage, waLink } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  message?: string;
}
const { locale, message } = Astro.props;
const t = useTranslations(locale);
---

<nav
  aria-label={t('mobilebar.label')}
  class="mobile-bar fixed inset-x-0 bottom-0 z-40 border-t border-cocoa/10 bg-cream/95 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-md md:hidden">
  <div class="grid grid-cols-2 gap-2">
    <a
      href={waLink(message ?? generalMessage(locale))}
      class="btn btn-wa btn-sm w-full"
      rel="noopener"
      target="_blank"
      data-track="whatsapp"
      data-track-context="mobile-bar">
      <Icon name="lucide:message-circle" class="size-4" aria-hidden="true" />
      {t('cta.whatsapp')}
    </a>
    <a href={path('shop', locale)} class="btn btn-ghost btn-sm w-full">
      <Icon name="lucide:shopping-bag" class="size-4" aria-hidden="true" />
      {t('cta.shop')}
    </a>
  </div>
</nav>
<div class="h-16 md:hidden" aria-hidden="true"></div>
