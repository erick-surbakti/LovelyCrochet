---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  id: {
    kicker: 'Dari benang ke kamu',
    title: 'Enam langkah di balik setiap rajutan',
    hint: 'Geser untuk melihat semua langkah',
    steps: [
      [
        'Pilih benang',
        'Kami memilih benang sesuai fungsinya, yang lembut dan bisa dirajut rapat untuk boneka, dan yang lebih kuat untuk tas.',
      ],
      [
        'Pola',
        'Ukuran, warna, dan detail disusun jadi pola. Untuk pesanan custom, detail dan warnanya kamu setujui dulu.',
      ],
      ['Merajut', 'Tusuk demi tusuk dengan tangan. Satu boneka besar bisa butuh 12–18 jam.'],
      ['Finishing', 'Ujung benang disembunyikan, bagian dijahit ganda, lalu bentuknya dirapikan dengan blocking.'],
      ['Bungkus kado', 'Kertas kraft, pita, dan kartu ucapan tulisan tangan. Gratis untuk semua pesanan.'],
      ['Kirim', 'Same-day ke Bekasi dan Jabodetabek, atau kurir ke seluruh Indonesia lengkap dengan resi.'],
    ],
  },
  en: {
    kicker: 'From yarn to you',
    title: 'Six steps behind every piece',
    hint: 'Scroll sideways to see every step',
    steps: [
      [
        'Choose the yarn',
        'We match the yarn to the job, soft enough to crochet tightly for dolls and sturdier for bags.',
      ],
      [
        'Pattern',
        'Size, colours and details become a pattern. For custom orders you approve the details and colours first.',
      ],
      ['Crochet', 'Stitch by stitch, by hand. A large doll can take 12–18 hours.'],
      ['Finishing', 'Ends are woven in, parts double-stitched, and the shape set by blocking.'],
      ['Gift wrap', 'Kraft paper, ribbon and a handwritten card. Free on every order.'],
      ['Ship', 'Same-day in Bekasi and Jabodetabek, or a tracked courier anywhere in Indonesia.'],
    ],
  },
}[locale];

/* Line icons, drawn in as the step scrolls into view */
const icons = [
  'M32 10a22 22 0 1 0 0.1 0 M14 24c10 6 26 6 36-2 M12 36c12 7 28 6 40-4 M20 50c8 3 18 2 26-4 M26 11c-6 12-6 30 4 42',
  'M16 8h24l10 10v38H16z M40 8v10h10 M22 28h20 M22 36h20 M22 44h12',
  'M10 54L46 18 M46 18c4-4 10-2 8 4-1 3-5 4-7 2 M14 50l-4 4',
  'M20 20a8 8 0 1 0 0.1 0 M20 44a8 8 0 1 0 0.1 0 M26 24l28 20 M26 40l28-20',
  'M10 26h44v28H10z M8 18h48v8H8z M32 18v36 M32 18c-6-10-18-10-14 0 M32 18c6-10 18-10 14 0',
  'M6 22h30v24H6z M36 30h12l8 8v8H36z M16 46a5 5 0 1 0 0.1 0 M46 46a5 5 0 1 0 0.1 0',
];
---

<section class="py-16" aria-labelledby="process-title">
  <div class="container-lc">
    <SectionTitle id="process-title" kicker={copy.kicker} title={copy.title} />
    <p class="mt-3 text-step--1 text-cocoa-soft md:hidden">{copy.hint} →</p>
  </div>
  <ol
    class="process mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto px-[max(var(--gutter),calc((100vw-var(--maxw))/2))] pb-6"
    tabindex="0"
    aria-label={copy.title}>
    {copy.steps.map(([title, body], i) => (
      <li class="process-step relative w-[78vw] max-w-[19rem] shrink-0 snap-start">
        <div class="scallop h-full p-6 shadow-[var(--shadow-warm)]">
          <div class="flex items-center justify-between">
            <svg viewBox="0 0 64 64" class="size-16" aria-hidden="true" focusable="false">
              <path
                class="yarn-path yarn-draw"
                pathLength="1"
                stroke="var(--color-rose-ink)"
                stroke-width="2.6"
                d={icons[i]}
              />
            </svg>
            <span class="font-display text-step-4 text-rose-clay" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-4 text-step-2">
            <span class="sr-only-lc">{i + 1}. </span>
            {title}
          </h3>
          <p class="mt-2 text-cocoa-soft">{body}</p>
        </div>
        {i < copy.steps.length - 1 && (
          <svg class="absolute top-1/2 -right-6 z-10 w-8" viewBox="0 0 32 16" aria-hidden="true" focusable="false">
            <path
              d="M0 8 C10 0 20 16 32 8"
              fill="none"
              stroke="var(--color-rose-clay)"
              stroke-width="2.5"
              stroke-dasharray="3 3"
            />
          </svg>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .process {
    scrollbar-width: thin;
    scrollbar-color: var(--color-rose-clay) transparent;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2));
  }
</style>
