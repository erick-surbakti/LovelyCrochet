---
import { Icon } from 'astro-icon/components';
import Logo from '@/components/ui/Logo.astro';
import LangSwitch from '@/components/ui/LangSwitch.astro';
import { site } from '@/config/site';
import { path, type Alternates, type Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { generalMessage, waLink } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  alternates: Alternates;
}
const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const current = Astro.url.pathname;

const nav = [
  { href: path('shop', locale), label: t('nav.shop') },
  { href: path('gifts', locale), label: t('nav.gifts') },
  { href: path('custom', locale), label: t('nav.custom') },
  { href: path('journal', locale), label: t('nav.journal') },
  { href: path('patterns', locale), label: t('nav.patterns') },
  { href: path('about', locale), label: t('nav.about') },
];
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
const wa = waLink(generalMessage(locale));
---

<header role="banner" class="sticky top-0 z-40 border-b border-cocoa/10 bg-cream/90 backdrop-blur-md">
  <div class="container-lc flex h-[4.25rem] items-center justify-between gap-2 sm:gap-4">
    <a href={path('home', locale)} aria-label={t('a11y.home')} class="rounded-full">
      <Logo />
    </a>

    <nav aria-label={t('a11y.mainNav')} class="hidden lg:block">
      <ul class="flex items-center gap-6 text-[0.95rem] font-semibold">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="link-draw py-1" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href={path('search', locale)}
        class="grid size-10 place-items-center rounded-full hover:bg-oat"
        aria-label={t('nav.search')}>
        <Icon name="lucide:search" class="size-5" aria-hidden="true" />
      </a>
      <LangSwitch locale={locale} alternates={alternates} />
      <a
        href={wa}
        class="btn btn-wa btn-sm hidden sm:inline-flex"
        rel="noopener"
        target="_blank"
        data-track="whatsapp"
        data-track-context="header">
        <Icon name="lucide:message-circle" class="size-4" aria-hidden="true" />
        {t('cta.whatsapp')}
        <span class="sr-only-lc"> {t('a11y.newTab')}</span>
      </a>

      <details class="menu relative lg:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full hover:bg-oat [&::-webkit-details-marker]:hidden"
          aria-label={t('a11y.menu')}>
          <Icon name="lucide:menu" class="menu-open size-6" aria-hidden="true" />
          <Icon name="lucide:x" class="menu-close size-6" aria-hidden="true" />
        </summary>
        <div class="scallop fixed inset-x-3 top-[4.6rem] max-h-[calc(100dvh-6rem)] overflow-y-auto p-6 shadow-[var(--shadow-warm-lg)]">
          <nav aria-label={t('a11y.mainNav')}>
            <ul class="space-y-1 text-step-1 font-semibold">
              {nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-xl px-3 py-2.5 hover:bg-oat"
                    aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
              <li>
                <a href={path('bekasi', locale)} class="block rounded-xl px-3 py-2.5 hover:bg-oat">
                  {t('nav.bekasi')}
                </a>
              </li>
              <li>
                <a href={path('contact', locale)} class="block rounded-xl px-3 py-2.5 hover:bg-oat">
                  {t('nav.contact')}
                </a>
              </li>
            </ul>
          </nav>
          <a
            href={wa}
            class="btn btn-wa mt-5 w-full"
            rel="noopener"
            target="_blank"
            data-track="whatsapp"
            data-track-context="menu">
            <Icon name="lucide:message-circle" class="size-5" aria-hidden="true" />
            {t('cta.whatsapp')} · {site.phone.display}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .menu .menu-close {
    display: none;
  }
  .menu[open] .menu-close {
    display: block;
  }
  .menu[open] .menu-open {
    display: none;
  }
</style>
