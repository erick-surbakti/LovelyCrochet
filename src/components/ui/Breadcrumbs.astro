---
import type { Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import type { Crumb } from '@/lib/schema';

interface Props {
  crumbs: Crumb[];
  locale: Locale;
}
const { crumbs, locale } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label={t('a11y.breadcrumb')} class="container-lc pt-5 text-step--1 text-cocoa-soft">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <svg width="14" height="10" viewBox="0 0 22 14" aria-hidden="true" class="opacity-50">
            <path
              d="M2 2 Q11 15 11 12 Q11 15 20 2"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            />
          </svg>
        )}
        {i < crumbs.length - 1 ? (
          <a href={c.path} class="link-draw">
            {c.name}
          </a>
        ) : (
          <span aria-current="page" class="font-semibold text-cocoa">
            {c.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
