---
/**
 * Keyboard-operable lightbox with zoom. Wrap any set of
 * <button data-lightbox-item data-full data-alt> triggers in <lc-lightbox>.
 * Native <dialog>: Esc closes, focus is trapped and returned to the trigger.
 * ←/→ navigate, Z or a click toggles zoom, pointer moves pan when zoomed.
 */
import type { Locale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  label: string;
  class?: string;
}
const { locale, label, class: cls } = Astro.props;
const copy = {
  id: { close: 'Tutup', prev: 'Foto sebelumnya', next: 'Foto berikutnya', zoom: 'Perbesar / perkecil', of: 'dari' },
  en: { close: 'Close', prev: 'Previous photo', next: 'Next photo', zoom: 'Zoom in / out', of: 'of' },
}[locale];
---

<lc-lightbox class={cls} data-of={copy.of}>
  <slot />
  <dialog class="lb" aria-label={label}>
    <div class="lb-stage">
      <img class="lb-img" alt="" decoding="async" />
    </div>
    <p class="lb-caption" aria-live="polite"></p>
    <div class="lb-controls">
      <button type="button" class="lb-btn" data-lb="prev" aria-label={copy.prev}>
        ‹
      </button>
      <button type="button" class="lb-btn" data-lb="zoom" aria-label={copy.zoom} aria-pressed="false">
        ⤢
      </button>
      <button type="button" class="lb-btn" data-lb="next" aria-label={copy.next}>
        ›
      </button>
      <button type="button" class="lb-btn lb-close" data-lb="close" aria-label={copy.close}>
        ✕
      </button>
    </div>
  </dialog>
</lc-lightbox>

<style is:global>
  lc-lightbox {
    display: block;
  }
  .lb {
    width: min(96vw, 64rem);
    max-height: 94dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .lb::backdrop {
    background: rgb(62 44 37 / 0.88);
  }
  .lb-stage {
    overflow: hidden;
    border-radius: 1.2rem;
    background: var(--color-paper);
    display: grid;
    place-items: center;
    max-height: 80dvh;
    cursor: zoom-in;
  }
  .lb-img {
    max-height: 80dvh;
    width: auto;
    transform-origin: var(--ox, 50%) var(--oy, 50%);
    transition: transform 0.35s var(--ease-yarn);
  }
  .lb.is-zoomed .lb-stage {
    cursor: zoom-out;
  }
  .lb.is-zoomed .lb-img {
    transform: scale(2.2);
  }
  .lb-caption {
    color: var(--color-cream);
    text-align: center;
    margin-top: 0.75rem;
    font-size: var(--text-step--1);
  }
  .lb-controls {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .lb-btn {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-cocoa);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
  }
  .lb-btn:hover {
    background: var(--color-butter);
  }
  .lb-btn:focus-visible {
    outline-color: var(--color-butter);
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-img {
      transition: none;
    }
  }
</style>

<script>
  class LcLightbox extends HTMLElement {
    private dialog!: HTMLDialogElement;
    private img!: HTMLImageElement;
    private caption!: HTMLElement;
    private items: HTMLElement[] = [];
    private index = 0;
    private trigger: HTMLElement | null = null;

    connectedCallback() {
      this.dialog = this.querySelector('dialog')!;
      this.img = this.dialog.querySelector('.lb-img')!;
      this.caption = this.dialog.querySelector('.lb-caption')!;
      this.items = [...this.querySelectorAll<HTMLElement>('[data-lightbox-item]')];
      this.items.forEach((el, i) => el.addEventListener('click', () => this.open(i, el)));
      this.dialog.addEventListener('click', this.onDialogClick);
      this.dialog.addEventListener('keydown', this.onKey);
      this.dialog.addEventListener('close', () => {
        this.setZoom(false);
        this.trigger?.focus();
      });
      this.dialog.querySelector('.lb-stage')!.addEventListener('pointermove', this.onPan as EventListener);
    }

    private open(i: number, trigger: HTMLElement) {
      this.trigger = trigger;
      this.show(i);
      this.dialog.showModal();
    }

    private show(i: number) {
      const n = this.items.length;
      this.index = (i + n) % n;
      const el = this.items[this.index]!;
      this.setZoom(false);
      this.img.src = el.dataset.full ?? '';
      this.img.alt = el.dataset.alt ?? '';
      if (el.dataset.w) this.img.width = Number(el.dataset.w);
      if (el.dataset.h) this.img.height = Number(el.dataset.h);
      this.caption.textContent = `${el.dataset.caption ?? el.dataset.alt ?? ''} (${this.index + 1} ${this.dataset.of} ${n})`;
      const multi = n > 1;
      this.dialog
        .querySelectorAll<HTMLElement>('[data-lb="prev"],[data-lb="next"]')
        .forEach((b) => (b.hidden = !multi));
    }

    private setZoom(on: boolean) {
      this.dialog.classList.toggle('is-zoomed', on);
      this.dialog.querySelector('[data-lb="zoom"]')?.setAttribute('aria-pressed', String(on));
    }

    private onDialogClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close') return this.dialog.close();
      if (action === 'prev') return this.show(this.index - 1);
      if (action === 'next') return this.show(this.index + 1);
      if (action === 'zoom' || target.closest('.lb-stage')) {
        return this.setZoom(!this.dialog.classList.contains('is-zoomed'));
      }
      if (target === this.dialog) this.dialog.close();
    };

    private onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') this.show(this.index - 1);
      else if (e.key === 'ArrowRight') this.show(this.index + 1);
      else if (e.key.toLowerCase() === 'z') this.setZoom(!this.dialog.classList.contains('is-zoomed'));
      else return;
      e.preventDefault();
    };

    private onPan = (e: PointerEvent) => {
      if (!this.dialog.classList.contains('is-zoomed')) return;
      const r = (e.currentTarget as HTMLElement).getBoundingClientRect();
      this.img.style.setProperty('--ox', `${((e.clientX - r.left) / r.width) * 100}%`);
      this.img.style.setProperty('--oy', `${((e.clientY - r.top) / r.height) * 100}%`);
    };
  }
  if (!customElements.get('lc-lightbox')) customElements.define('lc-lightbox', LcLightbox);
</script>
