---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import FaqList from '@/components/ui/FaqList.astro';
import Img from '@/components/ui/Img.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import YarnThread from '@/components/ui/YarnThread.astro';
import { site } from '@/config/site';
import { pageMeta } from '@/i18n/pageMeta';
import { entryPath, path, type Locale } from '@/i18n/routes';
import { getOccasions, getProducts, occasionUrl, productUrl, type Category } from '@/lib/content';
import { faqPage, itemList } from '@/lib/schema';
import { generalMessage, waLink } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  category: Category;
}
const { locale, category } = Astro.props;
const c = category.data;
const products = (await getProducts()).filter((p) => p.data.category === category.id);
const occasionIdsInCat = [...new Set(products.flatMap((p) => p.data.occasions))];
const occasions = (await getOccasions()).filter((o) => occasionIdsInCat.includes(o.id as never));
const alternates = { id: entryPath('category', 'id', c.slug.id), en: entryPath('category', 'en', c.slug.en) };
const faqs = c.faq.map((f) => ({ q: f.q[locale], a: f.a[locale] }));
const copy = {
  id: {
    pieces: 'Karya di kategori ini',
    faq: 'Tanya jawab',
    gifts: 'Cocok untuk momen',
    custom: 'Tidak menemukan yang pas? Kami bisa membuatnya custom.',
    emptyTitle: 'Foto koleksi segera hadir',
    emptyBody:
      'Kategori ini kami buat sesuai pesanan. Ceritakan model, ukuran, dan warna yang kamu mau, lalu kami bantu hitung harga dan waktu pengerjaannya.',
    emptyWa: 'Tanya lewat WhatsApp',
    emptyCustom: 'Mulai pesanan custom',
  },
  en: {
    pieces: 'Pieces in this category',
    faq: 'Questions & answers',
    gifts: 'Great for',
    custom: "Can't find the right one? We can make it to order.",
    emptyTitle: 'Photos coming soon',
    emptyBody:
      "We make this category to order. Tell us the style, size and colours you'd like, and we'll work out the price and lead time with you.",
    emptyWa: 'Ask on WhatsApp',
    emptyCustom: 'Start a custom order',
  },
}[locale];
const tilts = [-1.5, 1, -0.5, 1.5];
---

<BaseLayout
  locale={locale}
  title={c.seoTitle[locale]}
  description={c.seoDescription[locale]}
  alternates={alternates}
  breadcrumbs={[
    { name: pageMeta.shop[locale].label, path: path('shop', locale) },
    { name: c.name[locale], path: alternates[locale] },
  ]}
  schema={[
    ...(products.length
      ? [
          itemList(
            products.map((p) => ({
              url: new URL(productUrl(p, locale), site.url).toString(),
              name: p.data.name[locale],
            })),
          ),
        ]
      : []),
    faqPage(faqs),
  ]}>
  <section class="container-lc grid items-center gap-10 pt-8 pb-10 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <SectionTitle as="h1" kicker={pageMeta.shop[locale].label} title={c.name[locale]} />
      <div class="prose-lc mt-6">
        {c.intro[locale].map((para) => (
          <p>{para}</p>
        ))}
      </div>
      <p class="mt-6 flex flex-wrap gap-3">
        <a href={path('custom', locale)} class="link-hand">
          {copy.custom}
        </a>
      </p>
    </div>
    <div class="polaroid mx-auto w-full max-w-sm" style="--tilt:2deg">
      <Img
        name={c.image}
        eager
        locale={locale}
        sizes="(min-width: 1024px) 380px, 90vw"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
  </section>

  <YarnThread from={80} to={20} />

  <section class="container-lc py-10" aria-labelledby="cat-products">
    <h2 id="cat-products" class="text-step-3">
      {copy.pieces}
    </h2>
    {products.length > 0 ? (
      <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 md:gap-x-8 lg:grid-cols-4">
        {products.map((p, i) => (
          <ProductCard product={p} locale={locale} morph tilt={tilts[i % 4]} />
        ))}
      </div>
    ) : (
      <div class="scallop mt-8 max-w-3xl p-8 shadow-[var(--shadow-warm)]">
        <h3 class="text-step-2">{copy.emptyTitle}</h3>
        <p class="mt-2 text-cocoa-soft">{copy.emptyBody}</p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a
            href={waLink(generalMessage(locale, c.name[locale].toLowerCase()))}
            class="btn btn-wa"
            rel="noopener"
            target="_blank"
            data-track="whatsapp"
            data-track-context={`category-${category.id}`}>
            {copy.emptyWa}
          </a>
          <a href={path('custom', locale)} class="btn btn-ghost">
            {copy.emptyCustom}
          </a>
        </p>
      </div>
    )}
    {occasions.length > 0 && (
      <div class="mt-12">
        <h2 class="font-sans text-step--1 font-bold tracking-[0.14em] text-rose-ink uppercase">{copy.gifts}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {occasions.map((o) => (
            <li>
              <a href={occasionUrl(o, locale)} class="marker marker--butter">
                {o.data.name[locale]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <section class="container-lc py-12" aria-labelledby="cat-faq">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <h2 id="cat-faq" class="text-step-3">
        {copy.faq}
      </h2>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand locale={locale} context={`category-${category.id}`} />
</BaseLayout>
