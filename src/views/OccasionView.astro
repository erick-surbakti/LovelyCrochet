---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Img from '@/components/ui/Img.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import YarnThread from '@/components/ui/YarnThread.astro';
import { site } from '@/config/site';
import { pageMeta } from '@/i18n/pageMeta';
import { entryPath, path, type Locale } from '@/i18n/routes';
import { getOccasions, getProducts, occasionUrl, postUrl, postsByKeys, productUrl, type Occasion } from '@/lib/content';
import { itemList } from '@/lib/schema';
import { generalMessage } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  occasion: Occasion;
}
const { locale, occasion } = Astro.props;
const o = occasion.data;
const alternates = { id: entryPath('occasion', 'id', o.slug.id), en: entryPath('occasion', 'en', o.slug.en) };
const products = (await getProducts()).filter((p) => p.data.occasions.includes(occasion.id as never));
const others = (await getOccasions()).filter((x) => x.id !== occasion.id);
const posts = await postsByKeys(o.relatedJournal, locale);
const copy = {
  id: {
    picks: 'Pilihan kami',
    tips: 'Tips dari studio',
    more: 'Momen lainnya',
    read: 'Baca juga',
    when: 'Catat tanggalnya',
  },
  en: {
    picks: 'Our picks',
    tips: 'Tips from the studio',
    more: 'Other occasions',
    read: 'Read next',
    when: 'Mark the date',
  },
}[locale];
const tilts = [-1.5, 1, -0.5, 1.5];
const message = generalMessage(locale, `${locale === 'id' ? 'kado' : 'gifts for'} ${o.name[locale]}`);
---

<BaseLayout
  locale={locale}
  title={o.seoTitle[locale]}
  description={o.seoDescription[locale]}
  alternates={alternates}
  waMessage={message}
  breadcrumbs={[
    { name: pageMeta.gifts[locale].label, path: path('gifts', locale) },
    { name: o.name[locale], path: alternates[locale] },
  ]}
  schema={[
    itemList(
      products.map((p) => ({ url: new URL(productUrl(p, locale), site.url).toString(), name: p.data.name[locale] })),
    ),
  ]}>
  <section class="container-lc grid items-center gap-10 pt-8 pb-8 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <SectionTitle as="h1" kicker={o.name[locale]} title={o.title[locale]} lede={o.lede[locale]} />
      {o.when?.[locale] && (
        <p class="mt-6 inline-flex items-start gap-3 rounded-2xl bg-butter/70 px-5 py-3 font-semibold">
          <span aria-hidden="true">📌</span>
          <span>
            <span class="sr-only-lc">{copy.when}: </span>
            {o.when[locale]}
          </span>
        </p>
      )}
      <div class="prose-lc mt-6">
        {o.body[locale].map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
    <div class="polaroid mx-auto w-full max-w-sm" style="--tilt:-2deg">
      <Img
        name={o.image}
        eager
        locale={locale}
        sizes="(min-width: 1024px) 380px, 90vw"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
  </section>

  <YarnThread from={78} to={22} />

  <section class="container-lc py-10" aria-labelledby="occ-picks">
    <h2 id="occ-picks" class="text-step-3">
      {copy.picks}
    </h2>
    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 md:gap-x-8 lg:grid-cols-4">
      {products.map((p, i) => (
        <ProductCard product={p} locale={locale} morph tilt={tilts[i % 4]} />
      ))}
    </div>
  </section>

  <section class="container-lc grid gap-10 py-12 lg:grid-cols-2" aria-label={copy.tips}>
    <div class="blob bg-blush p-8">
      <h2 class="text-step-3">{copy.tips}</h2>
      <ul class="prose-lc mt-4">
        {o.tips[locale].map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </div>
    <div class="space-y-8">
      {posts.length > 0 && (
        <div>
          <h2 class="font-sans text-step--1 font-bold tracking-[0.14em] text-rose-ink uppercase">{copy.read}</h2>
          <ul class="mt-3 space-y-2">
            {posts.map((p) => (
              <li>
                <a href={postUrl(p)} class="link-hand">
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <h2 class="font-sans text-step--1 font-bold tracking-[0.14em] text-rose-ink uppercase">{copy.more}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {others.map((x) => (
            <li>
              <a href={occasionUrl(x, locale)} class="marker marker--butter">
                {x.data.name[locale]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} context={`occasion-${occasion.id}`} message={message} />
</BaseLayout>
