---
import { getImage as optimize } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import OrderComposer from '@/components/islands/OrderComposer.tsx';
import Img from '@/components/ui/Img.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import { site } from '@/config/site';
import { pageMeta } from '@/i18n/pageMeta';
import { entryPath, path, type Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import {
  categoryUrl,
  fromPrice,
  getCategories,
  getOccasions,
  getProducts,
  getSchemaReviews,
  occasionUrl,
  postUrl,
  postsByKeys,
  relatedProducts,
  type Product,
} from '@/lib/content';
import { formatDate, formatIDR, formatNumber } from '@/lib/format';
import { getImage } from '@/lib/images';
import { imageObject, product as productSchema, storeId } from '@/lib/schema';
import { productMessage, waLink, withUtm } from '@/lib/whatsapp';

interface Props {
  locale: Locale;
  product: Product;
}
const { locale, product } = Astro.props;
const t = useTranslations(locale);
const p = product.data;
const alternates = { id: entryPath('product', 'id', p.slugs.id), en: entryPath('product', 'en', p.slugs.en) };
const pageUrl = new URL(alternates[locale], site.url).toString();

const all = await getProducts();
const category = (await getCategories()).find((c) => c.id === p.category)!;
const occasions = (await getOccasions()).filter((o) => p.occasions.includes(o.id as never));
const posts = await postsByKeys(p.relatedJournal, locale);
const related = relatedProducts(product, all, 4);
const reviews = await getSchemaReviews(product.id);

const images = await Promise.all(
  p.images.map(async (name) => {
    const img = getImage(name);
    const full = await optimize({ src: img.src, width: 1600, format: 'webp' });
    const og = await optimize({ src: img.src, width: 1200, format: 'jpg' });
    return { name, img, full, og };
  }),
);

const prices = p.variants?.map((v) => v.price) ?? [p.price];
const low = Math.min(...prices);
const high = Math.max(...prices);
const lead = p.leadTimeDays ?? [site.leadTime.minDays, site.leadTime.maxDays];

const copy = {
  id: {
    specs: 'Detail & ukuran',
    size: 'Ukuran',
    weight: 'Berat',
    yarn: 'Benang',
    hook: 'Hakpen',
    sku: 'Kode',
    colors: 'Pilihan warna',
    care: 'Cara merawat',
    careLink: 'Panduan perawatan lengkap',
    sizeLink: 'Panduan ukuran',
    about: 'Tentang karya ini',
    category: 'Kategori',
    gifts: 'Cocok untuk',
    read: 'Bacaan terkait',
    related: 'Mungkin kamu juga suka',
    reviews: 'Ulasan',
    noReviews: 'Belum ada ulasan untuk produk ini di website. Ulasan hanya kami tampilkan dengan izin pembeli.',
    market: 'Juga tersedia di',
    gallery: 'Galeri foto produk',
    zoom: 'Perbesar foto',
    readyNote: (n?: number) => (n ? `Siap kirim · sisa ${n}` : 'Siap kirim'),
    poNote: `Dirajut setelah pesan · ${t('product.leadTime', { min: lead[0], max: lead[1] })}`,
    giftFree: 'Bungkus kado & kartu ucapan gratis',
  },
  en: {
    specs: 'Details & size',
    size: 'Size',
    weight: 'Weight',
    yarn: 'Yarn',
    hook: 'Hook',
    sku: 'SKU',
    colors: 'Colour options',
    care: 'Care',
    careLink: 'Full care guide',
    sizeLink: 'Size guide',
    about: 'About this piece',
    category: 'Category',
    gifts: 'Great for',
    read: 'Related reading',
    related: 'You might also like',
    reviews: 'Reviews',
    noReviews:
      "There are no reviews for this piece on the website yet. We only show reviews with the buyer's permission.",
    market: 'Also available on',
    gallery: 'Product photo gallery',
    zoom: 'Enlarge photo',
    readyNote: (n?: number) => (n ? `Ready to ship · ${n} left` : 'Ready to ship'),
    poNote: `Made after you order · ${t('product.leadTime', { min: lead[0], max: lead[1] })}`,
    giftFree: 'Free gift wrap & card',
  },
}[locale];

const dims = [
  p.dimensions.heightCm && `${locale === 'id' ? 'T' : 'H'} ${formatNumber(p.dimensions.heightCm, locale)} cm`,
  p.dimensions.widthCm && `${locale === 'id' ? 'L' : 'W'} ${formatNumber(p.dimensions.widthCm, locale)} cm`,
  p.dimensions.depthCm && `${locale === 'id' ? 'P' : 'D'} ${formatNumber(p.dimensions.depthCm, locale)} cm`,
]
  .filter(Boolean)
  .join(' × ');

const marketplaces = [
  ['Shopee', site.marketplaces.shopee],
  ['Tokopedia', site.marketplaces.tokopedia],
  ['TikTok Shop', site.marketplaces.tiktokShop],
].filter((m): m is [string, string] => Boolean(m[1]));

const schema = [
  productSchema({
    url: pageUrl,
    name: p.name[locale],
    description: p.summary[locale],
    sku: p.sku,
    images: images.map((i) => new URL(i.og.src, site.url).toString()),
    brand: site.name,
    category: category.data.name[locale],
    price: fromPrice(product),
    priceRange: [low, high],
    currency: site.currency,
    availability: p.availability,
    leadTimeDays: p.leadTimeDays,
    color: p.colors.map((c) => c.name[locale]),
    material: p.yarn[locale],
    weightGrams: p.weightGrams,
    shipping: {
      country: 'ID',
      rateMin: site.shipping.domesticRateMin,
      rateMax: site.shipping.domesticRateMax,
      handlingDays: site.shipping.readyHandlingDays,
      transitDays: site.shipping.transitDays,
    },
    returns: { days: site.returns.readyStockExchangeDays, permitted: p.availability === 'ready', country: 'ID' },
    reviews: reviews.map((r) => ({ author: r.data.name, rating: r.data.rating, body: r.data.text, date: r.data.date })),
    sellerId: storeId(site),
  }),
  ...images.map((i) =>
    imageObject({
      url: new URL(i.og.src, site.url).toString(),
      caption: i.img.caption[locale],
      width: Number(i.og.attributes.width),
      height: Number(i.og.attributes.height),
      creator: site.photoCredit,
      creditText: site.photoCredit,
      pageUrl,
    }),
  ),
];
const waFallback = waLink(productMessage({ locale, name: p.name[locale], url: pageUrl, price: p.price }));
---

<BaseLayout
  locale={locale}
  title={`${p.name[locale]} | ${site.name}`}
  description={p.summary[locale]}
  alternates={alternates}
  ogType="product"
  ogImageAlt={images[0]!.img.alt[locale]}
  waMessage={productMessage({ locale, name: p.name[locale], url: pageUrl, price: p.price })}
  breadcrumbs={[
    { name: pageMeta.shop[locale].label, path: path('shop', locale) },
    { name: category.data.name[locale], path: categoryUrl(category, locale) },
    { name: p.name[locale], path: alternates[locale] },
  ]}
  schema={schema}>
  <article class="container-lc grid gap-10 pt-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
    <Lightbox locale={locale} label={copy.gallery} class="lg:sticky lg:top-24 lg:self-start">
      <div class="grid gap-4">
        <button
          type="button"
          class="group relative block overflow-hidden rounded-[1.8rem] bg-oat shadow-[var(--shadow-warm-lg)]"
          data-lightbox-item
          data-full={images[0]!.full.src}
          data-w={images[0]!.full.attributes.width}
          data-h={images[0]!.full.attributes.height}
          data-alt={images[0]!.img.alt[locale]}
          data-caption={images[0]!.img.caption[locale]}>
          <div transition:name={`product-${product.id}`}>
            <Img
              name={images[0]!.name}
              eager
              locale={locale}
              sizes="(min-width: 1024px) 560px, 92vw"
              class="aspect-[4/5] w-full object-cover"
            />
          </div>
          <span class="marker marker--butter absolute top-4 left-4 -rotate-6">{t('product.handmade')}</span>
          <span class="absolute right-4 bottom-4 grid size-11 place-items-center rounded-full bg-cream/90 shadow-[var(--shadow-warm)]">
            <Icon name="lucide:zoom-in" class="size-5" aria-hidden="true" />
            <span class="sr-only-lc">{copy.zoom}</span>
          </span>
        </button>
        <ul class="grid grid-cols-3 gap-3">
          {images.slice(1).map((i) => (
            <li>
              <button
                type="button"
                class="polaroid block w-full !p-1.5 !pb-1.5"
                style="--tilt:-2deg"
                data-lightbox-item
                data-full={i.full.src}
                data-w={i.full.attributes.width}
                data-h={i.full.attributes.height}
                data-alt={i.img.alt[locale]}
                data-caption={i.img.caption[locale]}>
                <span class="sr-only-lc">{copy.zoom}</span>
                <Img
                  name={i.name}
                  locale={locale}
                  sizes="180px"
                  widths={[240, 360]}
                  class="aspect-square w-full object-cover"
                />
              </button>
            </li>
          ))}
        </ul>
      </div>
    </Lightbox>

    <div>
      <a href={categoryUrl(category, locale)} class="marker marker--sage">
        {category.data.name[locale]}
      </a>
      <h1 class="mt-4 text-step-4">{p.name[locale]}</h1>
      <p class="mt-4 text-step-3 font-display">
        {low !== high && <span class="text-step-1 text-cocoa-soft">{t('product.from')} </span>}
        {formatIDR(low)}
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-2">
        <span class:list={['marker', p.availability === 'ready' ? 'marker--sage' : 'marker--oat']}>
          {p.availability === 'ready' ? t('product.ready') : t('product.preorder')}
        </span>
        <span class="text-step--1 font-semibold text-cocoa-soft">
          {p.availability === 'ready' ? copy.readyNote(p.stock) : copy.poNote}
        </span>
        {p.giftWrap && <span class="text-step--1 font-semibold text-cocoa-soft">· {copy.giftFree}</span>}
      </p>
      <p class="mt-5 text-step-1">{p.summary[locale]}</p>

      <div class="scallop mt-8 p-6 shadow-[var(--shadow-warm)]">
        <OrderComposer
          client:idle
          locale={locale}
          productId={product.id}
          name={p.name[locale]}
          url={pageUrl}
          basePrice={p.price}
          variants={(p.variants ?? []).map((v) => ({ key: v.key, label: v.label[locale], price: v.price }))}
          colors={p.colors.map((c) => ({ key: c.key, label: c.name[locale], hex: c.hex }))}
          giftWrap={p.giftWrap}
          personalisable={p.personalisable}
        />
        <noscript>
          <a href={waFallback} class="btn btn-wa mt-4 w-full" rel="noopener" target="_blank">
            {t('cta.orderWa')}
          </a>
        </noscript>
      </div>

      {marketplaces.length > 0 && (
        <div class="mt-6">
          <p class="text-step--1 font-bold text-cocoa-soft">{copy.market}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {marketplaces.map(([name, url]) => (
              <li>
                <a
                  href={withUtm(url, 'product', product.id)}
                  class="btn btn-ghost btn-sm"
                  rel="noopener"
                  target="_blank"
                  data-track="marketplace"
                  data-track-channel={name}
                  data-track-product={product.id}>
                  {name}
                  <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <section class="mt-10" aria-labelledby="about-piece">
        <h2 id="about-piece" class="text-step-2">
          {copy.about}
        </h2>
        <div class="prose-lc mt-3">
          {p.description[locale].split('\n\n').map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </section>

      <section class="mt-10" aria-labelledby="specs">
        <h2 id="specs" class="text-step-2">
          {copy.specs}
        </h2>
        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 border-y-2 border-dashed border-cocoa/15 py-4">
          {dims && (
            <>
              <dt class="font-bold">{copy.size}</dt>
              <dd>
                {dims}
                {p.dimensions.note && (
                  <span class="block text-step--1 text-cocoa-soft">{p.dimensions.note[locale]}</span>
                )}
              </dd>
            </>
          )}
          {!dims && p.dimensions.note && (
            <>
              <dt class="font-bold">{copy.size}</dt>
              <dd>{p.dimensions.note[locale]}</dd>
            </>
          )}
          <dt class="font-bold">{copy.yarn}</dt>
          <dd>{p.yarn[locale]}</dd>
          <dt class="font-bold">{copy.hook}</dt>
          <dd>{formatNumber(p.hookMm, locale)} mm</dd>
          <dt class="font-bold">{copy.weight}</dt>
          <dd>± {formatNumber(p.weightGrams, locale)} g</dd>
          <dt class="font-bold">{copy.colors}</dt>
          <dd class="flex flex-wrap gap-2">
            {p.colors.map((c) => (
              <span class="inline-flex items-center gap-1.5">
                <i class="swatch" style={`background:${c.hex}`} aria-hidden="true" />
                {c.name[locale]}
              </span>
            ))}
          </dd>
          <dt class="font-bold">{copy.sku}</dt>
          <dd>{p.sku}</dd>
        </dl>
        <p class="mt-3 text-step--1">
          <a href={path('size', locale)} class="link-hand">
            {copy.sizeLink}
          </a>
        </p>
      </section>

      <section class="mt-10" aria-labelledby="care">
        <h2 id="care" class="text-step-2">
          {copy.care}
        </h2>
        <ul class="prose-lc mt-3">
          {p.care.map((c) => (
            <li>{c[locale]}</li>
          ))}
        </ul>
        <p class="mt-3 text-step--1">
          <a href={path('care', locale)} class="link-hand">
            {copy.careLink}
          </a>
        </p>
      </section>

      <section class="mt-10 grid gap-6 sm:grid-cols-2" aria-label={copy.gifts}>
        <div>
          <h2 class="font-sans text-step--1 font-bold tracking-[0.14em] text-rose-ink uppercase">{copy.gifts}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {occasions.map((o) => (
              <li>
                <a href={occasionUrl(o, locale)} class="marker marker--butter">
                  {o.data.name[locale]}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-sans text-step--1 font-bold tracking-[0.14em] text-rose-ink uppercase">{copy.read}</h2>
          <ul class="mt-3 space-y-2">
            {posts.map((post) => (
              <li>
                <a href={postUrl(post)} class="link-hand">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mt-10" aria-labelledby="reviews">
        <h2 id="reviews" class="text-step-2">
          {copy.reviews}
        </h2>
        {reviews.length === 0 ? (
          <p class="mt-3 text-cocoa-soft">{copy.noReviews}</p>
        ) : (
          <ul class="mt-4 space-y-4">
            {reviews.map((r) => (
              <li class="scallop p-5">
                <p class="font-bold">
                  {'★'.repeat(r.data.rating)}
                  <span class="sr-only-lc">{r.data.rating}/5</span>
                </p>
                <blockquote class="mt-2">“{r.data.text}”</blockquote>
                <p class="mt-2 text-step--1 text-cocoa-soft">
                  {r.data.name}, {r.data.city} · {formatDate(r.data.date, locale)}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </article>

  <section class="container-lc py-16" aria-labelledby="related">
    <h2 id="related" class="text-step-3">
      {copy.related}
    </h2>
    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 md:gap-x-8 lg:grid-cols-4">
      {related.map((r, i) => (
        <ProductCard product={r} locale={locale} morph tilt={[-1, 1, -0.5, 1.5][i]} />
      ))}
    </div>
  </section>
</BaseLayout>
