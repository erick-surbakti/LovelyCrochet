{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/koleksi/",
        "http://localhost:4321/koleksi/buket-bunga-rajut/",
        "http://localhost:4321/produk/boneka-hello-kitty-rajut/",
        "http://localhost:4321/pesanan-custom/",
        "http://localhost:4321/hadiah/kado-wisuda/",
        "http://localhost:4321/jurnal/jenis-benang-rajut-untuk-pemula/",
        "http://localhost:4321/pola-gratis/pola-tulip-mini/",
        "http://localhost:4321/en/"
      ],
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 30720 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
